# 公开配置。不要在这里或任何 VITE_ 变量里写模型密钥。
# 留空时，页面请求相对路径 api/classify。
# 本地 npm run dev 会挂上 cloud/functions/classify-subscriptions。
VITE_AI_ENDPOINT=

# 下面只给云函数进程使用，不要加 VITE_ 前缀，也不要提交真实值。
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# DeepSeek 可改为：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
